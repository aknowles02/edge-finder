# Public origin of the app (no trailing slash). Used for magic links and Stripe redirects.
APP_URL=http://localhost:5173

# Postgres (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edge_finder
PG_POOL_MAX=5

# Long random string: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated emails that can paste boards and enter results
ADMIN_EMAILS=you@example.com

# Resend (https://resend.com). Without a key, emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Edge Finder <boards@yourdomain.com>"

# Stripe — create a recurring $19.99/mo price and paste its id
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Live odds (https://the-odds-api.com). Without it the board shows pasted prices and says so.
ODDS_API_KEY=
# Shared secret for the odds scheduler (Vercel Cron + GitHub Actions): openssl rand -hex 32
CRON_SECRET=
